{
  "Jwt": {
    "Key": "n1JhITYAi5VtDjBojiozwKVq99jNmjjR1zZXavHqNt7",
    "Issuer": "oras-api",
    "Audience": "oras-client"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "oras-backend",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/Auth/{**catch-all}"
        }
      },

      "user-route": {
        "ClusterId": "oras-backend",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/User/{**catch-all}"
        }
      },

      "project-route": {
        "ClusterId": "oras-backend",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/Project/{**catch-all}"
        }
      },

      "task-route": {
        "ClusterId": "oras-backend",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/Task/{**catch-all}"
        }
      },

      "comment-route": {
        "ClusterId": "oras-backend",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/Comment/{**catch-all}"
        }
      },

      "documents-route": {
        "ClusterId": "oras-rag",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/documents/{**catch-all}"
        }
      },

      "chat-route": {
        "ClusterId": "oras-rag",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/chat/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "oras-backend": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5082/"
          }
        }
      },

      "oras-rag": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8000/"
          }
        }
      }
    }
  }
}